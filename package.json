{
  "name": "aff-marketplace",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check:budget": "node scripts/check-bundle-budget.mjs",
    "db:start": "supabase start",
    "db:stop": "supabase stop",
    "db:env": "bash scripts/supabase-env.sh",
    "db:reset": "supabase db reset",
    "db:types": "supabase gen types typescript --local --schema public > src/lib/supabase/database.types.ts",
    "test:db": "vitest run -c vitest.db.config.ts",
    "db:advisors": "bash scripts/db-advisors.sh",
    "check:lighthouse": "node scripts/check-lighthouse.mjs"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/inter": "5.3.0",
    "@pdf-lib/fontkit": "1.1.1",
    "@supabase/realtime-js": "2.117.3",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "@tanstack/react-table": "8.21.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.0",
    "next-intl": "4.14.9",
    "next-themes": "0.4.6",
    "nodemailer": "7.0.13",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "radix-ui": "1.8.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.56.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.5",
    "@types/nodemailer": "7.0.12",
    "@types/pg": "8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "chrome-launcher": "1.2.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "eslint-config-prettier": "10.1.8",
    "fast-check": "4.10.2",
    "lighthouse": "13.4.1",
    "otplib": "12.0.1",
    "pdfjs-dist": "4.10.38",
    "pg": "8.23.1",
    "prettier": "3.9.10",
    "prettier-plugin-tailwindcss": "0.8.1",
    "supabase": "2.120.0",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@swc/core",
      "supabase",
      "unrs-resolver"
    ]
  }
}
