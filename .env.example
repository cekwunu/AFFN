# Copy to .env.local and fill in. Never commit real values.
# NEXT_PUBLIC_* variables are PUBLIC: they are built into the browser bundle.
# Every other variable is SERVER-ONLY and must never be read from client code.

# --- Site -------------------------------------------------------------------
# Public base URL, used for QR codes, email links and order-tracking links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Supabase ---------------------------------------------------------------
# Project URL. Local: printed by `pnpm db:start` (http://127.0.0.1:54321).
NEXT_PUBLIC_SUPABASE_URL=
# Anon / publishable key. Safe in the browser; all access is limited by RLS.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# SERVER-ONLY. Service role / secret key: bypasses RLS. Used only in server code
# (webhooks, scheduled jobs, settlement) via src/lib/supabase/admin.ts.
SUPABASE_SERVICE_ROLE_KEY=

# --- Payments (PSP) ---------------------------------------------------------
# SERVER-ONLY. Which PaymentProvider implementation to use: mock | stripe | swedbank.
# "mock" needs no credentials and is the default for local development and tests.
PAYMENT_PROVIDER=mock

# SERVER-ONLY. Stripe Connect secret key (sk_test_... / sk_live_...).
STRIPE_SECRET_KEY=
# SERVER-ONLY. Signing secret for the Stripe webhook endpoint (whsec_...).
STRIPE_WEBHOOK_SECRET=

# SERVER-ONLY. Swedbank Pay merchant API token.
SWEDBANK_PAY_MERCHANT_TOKEN=
# SERVER-ONLY. Swedbank Pay payee ID for AFFN's merchant account.
SWEDBANK_PAY_PAYEE_ID=
# SERVER-ONLY. Swedbank Pay API base URL (test: https://api.externalintegration.payex.com).
SWEDBANK_PAY_API_URL=

# --- Company data -----------------------------------------------------------
# SERVER-ONLY. Brønnøysundregistrene Enhetsregisteret open API (no key needed).
BRREG_API_URL=https://data.brreg.no/enhetsregisteret/api

# --- Auth -------------------------------------------------------------------
# SERVER-ONLY. Slug of the organization that vendor and sponsor self sign-up joins (AUTH-03).
DEFAULT_ORGANIZATION_SLUG=affn
# SERVER-ONLY. Secret for hashing rate-limit keys (no IPs or emails are stored).
# Use a long random value in production: `openssl rand -hex 32`.
RATE_LIMIT_SECRET=
# SERVER-ONLY. Optional multiplier for per-IP limits (tests only; default 1).
# RATE_LIMIT_IP_SCALE=1

# --- Email (SMTP; the provider must process data in the EU) ------------------
# Verification and reset emails are sent by Supabase Auth (configure SMTP there too).
# The app sends invitations itself. Local: Mailpit on 127.0.0.1:54325, UI on :54324.
# Without SMTP_HOST in development, emails are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
# SERVER-ONLY.
SMTP_PASS=
# true for implicit TLS (port 465); otherwise STARTTLS is used when offered.
SMTP_SECURE=false
# Sender address, e.g. "AFF Marketplace <no-reply@example.no>".
EMAIL_FROM=

# --- Tests ------------------------------------------------------------------
# Port for the dev server started by Playwright (default 3000).
# PORT=3000
